# Copy to .env and fill in the values: cp .env.example .env
# .env is git-ignored. It is read by both docker compose and the Spring Boot app.

# Postgres
DB_USERNAME=admin
DB_PASSWORD=change-me
# Host port for Postgres. Change it if 5432 is taken (e.g. a local PostgreSQL install).
# docker compose publishes this port and the app connects to it.
# DB_HOST=localhost
# DB_PORT=5432
# Or override the full connection URLs:
# R2DBC_URL=r2dbc:postgresql://localhost:5432/leaderboard
# JDBC_URL=jdbc:postgresql://localhost:5432/leaderboard

# Redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# JWT signing key, at least 32 bytes. Generate one with: openssl rand -hex 32
JWT_SECRET=
# JWT_EXPIRATION_MS=86400000
