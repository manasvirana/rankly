{$SITE_ADDRESS:localhost} {
	encode gzip

	@backend path /api/* /ws/*
	handle @backend {
		reverse_proxy app1:8080 app2:8080 {
			lb_policy round_robin
			lb_try_duration 5s
			health_uri /api/v1/health
			health_interval 10s
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
